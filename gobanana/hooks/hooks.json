{
  "description": "GoBanana guardrails: route GoBanana asks (the name or \"go wild\") to the GoBanana skills; in a GoBanana session only, check UI drafts as they are written and hold an unchecked draft back from being published; and let the plugin's own pinned check scripts (tools/gb-*.mjs) run without a prompt.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/gb-route.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/gb-allow.mjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Artifact|SendUserFile",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/gb-gate.mjs\" pre",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/gb-gate.mjs\" post",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__.*get_playbook|mcp__.*[Bb]anana.*__(new|open|get)_canvas",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/gb-gate.mjs\" loaded",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
